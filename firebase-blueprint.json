{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "A hotel room definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "type": { "type": "string", "enum": ["single", "double", "suite", "deluxe"] },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["available", "occupied", "maintenance", "cleaning"] },
        "capacity": { "type": "number" },
        "amenities": { "type": "array" },
        "image": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "number", "type", "price", "status", "capacity"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A room booking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "guestName": { "type": "string" },
        "guestEmail": { "type": "string" },
        "guestPhone": { "type": "string" },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "checked-in", "checked-out", "cancelled"] },
        "createdAt": { "type": "string" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "expectedPersonCount": { "type": "number" }
      },
      "required": ["id", "roomId", "guestName", "guestEmail", "checkIn", "checkOut", "totalAmount", "status", "createdAt"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Hotel staff and guest service request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "type": { "type": "string", "enum": ["housekeeping", "room-service", "maintenance", "concierge"] },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "roomId", "type", "description", "status", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "A registered user profile with permissions, live presence status, and HR authorization",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff", "guest"] },
        "phone": { "type": "string" },
        "staffSecretKey": { "type": "string" },
        "hrApproved": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "lastLoginAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "loginMethod": { "type": "string" },
        "registeredAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Star rating and text feedback submitted by guests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "userEmail", "rating", "comment", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application configuration and guest view settings including logo visibility and branding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "showLogo": { "type": "boolean" },
        "logoType": { "type": "string", "enum": ["emblem", "image"] },
        "customLogoUrl": { "type": "string" },
        "logoText": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "showLogo", "logoType"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Hotel inventory of rooms"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Room booking reservations"
    },
    "/serviceRequests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Room service or maintenance requests"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with authorization roles"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "Star ratings and written reviews submitted by guests"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Global application settings such as guest view logo and branding"
    }
  }
}
